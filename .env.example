DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SHOW_DEMO_CONTENT=true
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
CONTACT_FORM_ENABLED=false
SACRAMENT_FORM_ENABLED=false
TITHE_FORM_ENABLED=false
NEWSLETTER_ENABLED=false
# Opcional: bucket S3/Neon Object Storage para as mídias (requer AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION)
MEDIA_BUCKET=
# Defina como false quando DATABASE_URL apontar para um banco em produção (schema só por migrações)
PAYLOAD_DB_PUSH=
